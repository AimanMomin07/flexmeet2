<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_night_gradient">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F3F6FB"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:paddingStart="18dp"
            android:paddingEnd="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FlexMeet"
                android:textColor="#5368D8"
                android:textSize="22sp"
                android:textStyle="bold" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/profile_btn"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="end"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_avatar_ring"
                android:padding="2dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_person_profile"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.SmallComponent"
                app:strokeColor="#D6DDF0"
                app:strokeWidth="1dp" />
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:id="@+id/nav_host_fragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_navigation"
        app:layout_constraintTop_toBottomOf="@+id/app_bar" />

    <LinearLayout
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_nav_glass"
        android:elevation="5dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="6dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/nav_home"
            style="@style/FlexMeetNavigationItem"
            android:contentDescription="Home">
            <ImageView android:id="@+id/nav_home_icon" style="@style/FlexMeetNavigationIcon" android:src="@drawable/ic_home" />
            <TextView android:id="@+id/nav_home_label" style="@style/FlexMeetNavigationLabel" android:text="Home" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_history"
            style="@style/FlexMeetNavigationItem"
            android:contentDescription="History">
            <ImageView android:id="@+id/nav_history_icon" style="@style/FlexMeetNavigationIcon" android:src="@drawable/ic_history" />
            <TextView android:id="@+id/nav_history_label" style="@style/FlexMeetNavigationLabel" android:text="History" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_chat"
            style="@style/FlexMeetNavigationItem"
            android:contentDescription="Chat">
            <ImageView android:id="@+id/nav_chat_icon" style="@style/FlexMeetNavigationIcon" android:src="@android:drawable/stat_notify_chat" />
            <TextView android:id="@+id/nav_chat_label" style="@style/FlexMeetNavigationLabel" android:text="Chat" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_contacts"
            style="@style/FlexMeetNavigationItem"
            android:contentDescription="Friends">
            <ImageView android:id="@+id/nav_contacts_icon" style="@style/FlexMeetNavigationIcon" android:src="@drawable/ic_contacts" />
            <TextView android:id="@+id/nav_contacts_label" style="@style/FlexMeetNavigationLabel" android:text="Friends" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_explore"
            style="@style/FlexMeetNavigationItem"
            android:contentDescription="Live">
            <ImageView android:id="@+id/nav_explore_icon" style="@style/FlexMeetNavigationIcon" android:src="@drawable/ic_explore" />
            <TextView android:id="@+id/nav_explore_label" style="@style/FlexMeetNavigationLabel" android:text="Live" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>