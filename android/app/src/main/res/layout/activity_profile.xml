<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_night_gradient">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F7F9FC"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:paddingStart="8dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/back_btn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_glass_row"
                android:contentDescription="Back"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="#53627A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="Your profile"
                android:textColor="#1C2941"
                android:textSize="20sp"
                android:textStyle="bold" />
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="24dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="18dp"
            android:paddingEnd="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero_glass"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YOUR FLEXMEET"
                    android:textColor="#586CCB"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.16" />

                <FrameLayout
                    android:layout_width="116dp"
                    android:layout_height="116dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_avatar_ring"
                    android:padding="4dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/profile_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_person_profile"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.LargeComponent" />

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/change_photo_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:contentDescription="Change profile photo"
                        app:backgroundTint="#5368D8"
                        app:fabSize="mini"
                        app:srcCompat="@drawable/ic_camera"
                        app:tint="#FFFFFF" />
                </FrameLayout>

                <TextView
                    android:id="@+id/user_name_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:text="Loading..."
                    android:textColor="#1D2A42"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/user_email_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:text="email@example.com"
                    android:textColor="#687890"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_glass_row"
                    android:drawablePadding="7dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="7dp"
                    android:text="●  FLEXMEET MEMBER"
                    android:textColor="#4E8B83"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.07" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/edit_profile_btn"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="20dp"
                    android:text="Edit profile"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="#5368D8"
                    app:cornerRadius="18dp"
                    app:icon="@drawable/ic_edit"
                    app:iconTint="#FFFFFF" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp"
                android:text="ACCOUNT &amp; PREFERENCES"
                android:textColor="#7A889C"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.14" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:orientation="vertical"
                android:padding="0dp">

                <include
                    android:id="@+id/settings_notifications"
                    layout="@layout/item_profile_setting"
                    android:tag="notifications" />

                <include
                    android:id="@+id/settings_privacy"
                    layout="@layout/item_profile_setting"
                    android:tag="privacy" />

                <include
                    android:id="@+id/settings_about"
                    layout="@layout/item_profile_setting"
                    android:tag="about" />

                <include
                    android:id="@+id/logout_btn"
                    layout="@layout/item_profile_setting"
                    android:tag="logout" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="FlexMeet  ·  Meet without limits"
                android:textColor="#8290A3"
                android:textSize="12sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>