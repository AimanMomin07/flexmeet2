<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.flexmeet">

    <!-- ========================= -->
    <!-- NETWORK PERMISSIONS -->
    <!-- ========================= -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- ========================= -->
    <!-- CAMERA & MICROPHONE -->
    <!-- ========================= -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Declare hardware features -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>

    <!-- ========================= -->
    <!-- FOREGROUND SERVICE (Recording) -->
    <!-- ========================= -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ========================= -->
    <!-- ALARMS & REMINDERS -->
    <!-- ========================= -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- ========================= -->
    <!-- MEDIA ACCESS (Android 13+) -->
    <!-- ========================= -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <!-- ========================= -->
    <!-- VIBRATION -->
    <!-- ========================= -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".FlexMeetApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.FlexMeet"
        android:usesCleartextTraffic="true"
        tools:targetApi="33">

        <!-- ========================= -->
        <!-- SPLASH / LAUNCHER -->
        <!-- ========================= -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.SplashScreen">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- ========================= -->
        <!-- DASHBOARD (Deep Link Handler) -->
        <!-- ========================= -->
        <activity
            android:name=".activities.DashboardActivity"
            android:exported="true">

            <!-- Deep Link Support -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="https"
                    android:host="flexmeet-aiman-3859.vercel.app"
                    android:pathPrefix="/join/" />
            </intent-filter>

        </activity>

        <!-- ========================= -->
        <!-- OTHER ACTIVITIES -->
        <!-- ========================= -->
        <activity android:name=".activities.FlexMeetWebActivity" android:exported="false" />
        <activity android:name=".activities.LoginActivity" android:exported="false" />
        <activity android:name=".activities.RegisterActivity" android:exported="false" />
        <activity android:name=".activities.VideoCallActivity" android:exported="false" />
        <activity android:name=".activities.LiveKitCallActivity" android:exported="false" />
        <activity android:name=".activities.ScheduleMeetingActivity" android:exported="false" />
        <activity android:name=".activities.ProfileActivity" android:exported="false" />
        <activity android:name=".activities.PrivateChatActivity" android:exported="false" />
        <activity android:name=".activities.NotificationsSettingsActivity" android:exported="false" />
        <activity android:name=".activities.SecuritySettingsActivity" android:exported="false" />
        <activity android:name=".activities.AboutAppActivity" android:exported="false" />

        <!-- ========================= -->
        <!-- SERVICES -->
        <!-- ========================= -->
        <service
            android:name=".services.ScreenRecordService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <service
            android:name=".services.FlexMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- ========================= -->
        <!-- RECEIVERS -->
        <!-- ========================= -->
        <receiver android:name=".services.AlarmReceiver" android:exported="false" />

        <!-- ========================= -->
        <!-- GOOGLE MAPS API -->
        <!-- ========================= -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="YOUR_GOOGLE_MAPS_API_KEY_HERE" />

    </application>

</manifest>
